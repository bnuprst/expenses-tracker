# Copy to .env (chmod 600) next to docker-compose.prod.yml. Never commit it.

# Public URL the edge Caddy serves the API on (JWT issuer, default bank redirect URL)
PUBLIC_BASE_URL=https://expenses.bookkeebara.com
TZ=Europe/Warsaw
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
JWT_TTL_DAYS=30

# --- Enable Banking (leave EB_APP_ID empty to disable bank sync) ---
EB_APP_ID=
# The private key goes in .secrets/enablebanking.pem (chmod 600); compose mounts it as a secret.
# Register this exact URL as a redirect URL of the Enable Banking application:
EB_REDIRECT_URL=https://expenses.bookkeebara.com/api/v1/banking/callback
APP_REDIRECT_URL=expenses://bank-connected
EB_CONSENT_DAYS=180
EB_INITIAL_HISTORY_DAYS=90
# ISO-8601 duration
SYNC_INTERVAL=PT6H

# --- LLM fallback (any OpenAI-compatible API) ---
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...  LLM_MODEL=gpt-6-luna
# Ollama:      LLM_BASE_URL=http://ollama:11434/v1      (no key)           LLM_MODEL=llama3.1:8b
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=...   LLM_MODEL=openai/gpt-6-luna
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# OpenAI reasoning models only (none|minimal|low|medium|high); leave empty for other providers.
LLM_REASONING_EFFORT=low
# Leave empty for GPT-5/6 models, which reject non-default temperatures.
LLM_TEMPERATURE=
LLM_CONFIDENCE_THRESHOLD=0.7
