# Copy to deploy/.env and fill in. Never commit .env or the private key.

# Public URL Caddy serves the API on (used for JWT issuer and the default bank redirect URL)
PUBLIC_BASE_URL=https://expenses.example.com
DB_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=change-me
JWT_TTL_DAYS=30

# --- Enable Banking (leave EB_APP_ID empty to disable bank sync) ---
EB_APP_ID=
# Private key goes in deploy/secrets/enablebanking.pem (mounted as a docker secret)
# Must be registered as an allowed redirect URL for the application in the Enable Banking control panel
EB_REDIRECT_URL=https://expenses.example.com/api/v1/banking/callback
APP_REDIRECT_URL=expenses://bank-connected
EB_CONSENT_DAYS=180
EB_INITIAL_HISTORY_DAYS=90
# ISO-8601 duration
SYNC_INTERVAL=PT6H

# --- LLM fallback (any OpenAI-compatible API) ---
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...   LLM_MODEL=gpt-4.1-mini
# Ollama:      LLM_BASE_URL=http://ollama:11434/v1      (no key)            LLM_MODEL=llama3.1:8b
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=...    LLM_MODEL=...
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_CONFIDENCE_THRESHOLD=0.7
